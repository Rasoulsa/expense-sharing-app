# Local development only. Replace this with a real key when DEBUG is false.
DEBUG=true
SECRET_KEY=dev-only-insecure-key-change-before-production
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional absolute SQLite file path; defaults to backend/.local/expenses.sqlite3.
# SQLITE_PATH=/absolute/path/to/expenses.sqlite3
# Leave DATABASE_URL unset for local SQLite (an empty value is invalid).
# Production: configure this privately in Hamravesh using the connection panel's
# internal host and credentials. Resource expense-db has database name postgres.
# Placeholder only; percent-encode special characters in the username/password.
# DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@INTERNAL_DB_HOST:5432/postgres
# DATABASE_URL takes precedence over SQLITE_PATH; only PostgreSQL URLs are accepted.
